{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ReleaseSource",
  "$defs": {
    "ReleaseSource": {
      "type": "object",
      "properties": {
        "importer": {
          "type": "string"
        },
        "importer_version": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "original_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delimiter": {
          "type": "string"
        },
        "decimal": {
          "type": "string",
          "enum": [
            ".",
            ","
          ]
        },
        "na_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mapping": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "file": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "name": {
              "type": "string"
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "bucket": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "sha256",
            "bucket",
            "key"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "importer",
        "importer_version",
        "tool",
        "tool_version",
        "original_columns",
        "delimiter",
        "decimal",
        "na_tokens"
      ],
      "additionalProperties": false
    }
  }
}
