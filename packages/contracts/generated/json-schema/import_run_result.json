{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ImportRunResult",
  "$defs": {
    "ImportRunResult": {
      "type": "object",
      "properties": {
        "importer": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DatasetKind"
        },
        "contract_version": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_id": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warn"
                ]
              },
              "failing_rows": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "message": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "rule_id",
              "severity",
              "failing_rows",
              "message",
              "source",
              "examples"
            ],
            "additionalProperties": false
          }
        },
        "column_stats": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "null_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "distinct_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "min": {
                "type": [
                  "number",
                  "string",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "null_count",
              "distinct_count"
            ],
            "additionalProperties": false
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "step",
              "detail"
            ],
            "additionalProperties": false
          }
        },
        "source": {
          "$ref": "#/$defs/ReleaseSource"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseStorage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "importer",
        "kind",
        "contract_version",
        "passed",
        "row_count",
        "failures",
        "column_stats",
        "transformations",
        "source",
        "output"
      ],
      "additionalProperties": false
    },
    "DatasetKind": {
      "type": "string",
      "enum": [
        "protein_quant",
        "precursor_quant",
        "differential_abundance",
        "dose_response",
        "qc_metrics",
        "rnaseq_counts",
        "crispr_gene_summary",
        "compound",
        "compound_property",
        "target_annotation",
        "id_mapping",
        "experiment_version",
        "sample",
        "file_object",
        "pipeline_run"
      ]
    },
    "ReleaseSource": {
      "type": "object",
      "properties": {
        "importer": {
          "type": "string"
        },
        "importer_version": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "original_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delimiter": {
          "type": "string"
        },
        "decimal": {
          "type": "string",
          "enum": [
            ".",
            ","
          ]
        },
        "na_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mapping": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "file": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "name": {
              "type": "string"
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "bucket": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "sha256",
            "bucket",
            "key"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "importer",
        "importer_version",
        "tool",
        "tool_version",
        "original_columns",
        "delimiter",
        "decimal",
        "na_tokens"
      ],
      "additionalProperties": false
    },
    "ReleaseStorage": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "parquet"
        },
        "bucket": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "format",
        "bucket",
        "key",
        "sha256",
        "size_bytes"
      ],
      "additionalProperties": false
    }
  }
}
