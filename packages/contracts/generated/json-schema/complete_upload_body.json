{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CompleteUploadBody",
  "$defs": {
    "CompleteUploadBody": {
      "type": "object",
      "properties": {
        "parts": {
          "minItems": 1,
          "maxItems": 10000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "part_number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "etag": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "part_number",
              "etag"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "parts"
      ],
      "additionalProperties": false
    }
  }
}
