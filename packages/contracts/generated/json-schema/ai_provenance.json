{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AiProvenance",
  "$defs": {
    "AiProvenance": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "none",
            "stub",
            "anthropic",
            "bedrock"
          ]
        },
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "query_specs": {
          "type": "array",
          "items": {}
        },
        "release_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_tokens": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_version",
        "tools",
        "query_specs",
        "release_ids",
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false
    }
  }
}
