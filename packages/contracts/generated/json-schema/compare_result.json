{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CompareResult",
  "$defs": {
    "CompareResult": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "measured_in_all": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "left_out": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "ambiguous": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "total_overlap": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "overlap": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "feature_id": {
                "type": "string"
              },
              "gene": {
                "type": "string"
              },
              "log2_fc": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "significant": {
                "type": "array",
                "items": {
                  "type": "boolean"
                }
              }
            },
            "required": [
              "feature_id",
              "gene",
              "log2_fc",
              "significant"
            ],
            "additionalProperties": false
          }
        },
        "intersections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "members": {
                "type": "array",
                "items": {
                  "type": "boolean"
                }
              },
              "count": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "members",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "scatter": {
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "layout": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "data",
            "layout"
          ],
          "additionalProperties": false
        },
        "upset": {
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "layout": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "data",
            "layout"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "labels",
        "measured_in_all",
        "left_out",
        "ambiguous",
        "total_overlap",
        "overlap",
        "intersections",
        "scatter",
        "upset"
      ],
      "additionalProperties": false
    }
  }
}
