{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AlertList",
  "$defs": {
    "AlertList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Alert"
          }
        },
        "unread": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "items",
        "unread"
      ],
      "additionalProperties": false
    },
    "Alert": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "watch": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "protein",
                "gene",
                "compound"
              ]
            },
            "key": {
              "type": "string"
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "key",
            "label"
          ],
          "additionalProperties": false
        },
        "release_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "dataset_name": {
          "type": "string"
        },
        "program_code": {
          "type": "string"
        },
        "experiment_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "experiment_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "contrast_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "log2_fc": {
          "type": [
            "number",
            "null"
          ]
        },
        "adj_p_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "rule": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "read_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "watch",
        "release_id",
        "dataset_name",
        "program_code",
        "experiment_id",
        "experiment_name",
        "contrast_label",
        "log2_fc",
        "adj_p_value",
        "rule",
        "created_at",
        "read_at"
      ],
      "additionalProperties": false
    }
  }
}
