{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PipelineList",
  "$defs": {
    "PipelineList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pipeline"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "Pipeline": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "runner_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "local",
              "aws_batch",
              "healthomics",
              "fake"
            ]
          }
        },
        "assay_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "proteomics_dia",
              "proteomics_dda",
              "proteomics_tmt",
              "rnaseq",
              "crispr_screen",
              "ngs_raw"
            ]
          }
        },
        "params_schema": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "default_params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "output_importers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "id",
        "key",
        "name",
        "repo",
        "revision",
        "runner_types",
        "assay_types",
        "params_schema",
        "default_params",
        "output_importers",
        "created_at"
      ],
      "additionalProperties": false
    }
  }
}
