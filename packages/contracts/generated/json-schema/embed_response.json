{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EmbedResponse",
  "$defs": {
    "EmbedResponse": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "dims": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "embeddings": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      },
      "required": [
        "model",
        "dims",
        "embeddings"
      ],
      "additionalProperties": false
    }
  }
}
