{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LineageQuery",
  "$defs": {
    "LineageQuery": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "dataset_release",
            "pipeline_run",
            "experiment_version",
            "chart"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "direction": {
          "type": "string",
          "enum": [
            "upstream",
            "downstream",
            "both"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    }
  }
}
