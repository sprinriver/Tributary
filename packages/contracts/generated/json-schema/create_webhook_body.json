{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CreateWebhookBody",
  "$defs": {
    "CreateWebhookBody": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2000,
          "format": "uri"
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "events": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "run.status"
            ]
          }
        }
      },
      "required": [
        "url",
        "events"
      ],
      "additionalProperties": false
    }
  }
}
