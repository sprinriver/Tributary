{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CompoundSearchBody",
  "$defs": {
    "CompoundSearchBody": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "mode": {
          "type": "string",
          "enum": [
            "substructure",
            "similarity"
          ]
        },
        "query_type": {
          "default": "smarts",
          "type": "string",
          "enum": [
            "smarts",
            "smiles"
          ]
        },
        "min_similarity": {
          "default": 0.5,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "program_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "limit": {
          "default": 100,
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "query",
        "mode",
        "query_type",
        "min_similarity",
        "limit"
      ],
      "additionalProperties": false
    }
  }
}
