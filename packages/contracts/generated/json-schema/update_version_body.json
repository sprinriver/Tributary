{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/UpdateVersionBody",
  "$defs": {
    "UpdateVersionBody": {
      "type": "object",
      "properties": {
        "experiment_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "species": {
          "anyOf": [
            {
              "$ref": "#/$defs/OntologyTerm"
            },
            {
              "type": "null"
            }
          ]
        },
        "spectral_library": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "time_points": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "maxLength": 10000
        },
        "custom_fields": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "$ref": "#/$defs/MetadataFieldDef"
          }
        },
        "custom": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "OntologyTerm": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*:[A-Za-z0-9_.-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "MetadataFieldDef": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "experiment",
            "sample"
          ]
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "number",
            "integer",
            "boolean",
            "date",
            "enum",
            "ontology_term",
            "quantity"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "searchable": {
          "type": "boolean"
        },
        "unit": {
          "type": "string"
        },
        "ontology": {
          "type": "string"
        },
        "enumValues": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quantityKind": {
          "type": "string",
          "enum": [
            "concentration",
            "time"
          ]
        },
        "validator": {
          "type": "string",
          "enum": [
            "plate_well"
          ]
        }
      },
      "required": [
        "scope",
        "key",
        "label",
        "type",
        "required",
        "searchable"
      ],
      "additionalProperties": false
    }
  }
}
