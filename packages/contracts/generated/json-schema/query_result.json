{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/QueryResult",
  "$defs": {
    "QueryResult": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "uuid",
                  "double",
                  "integer",
                  "boolean",
                  "date",
                  "timestamp",
                  "text[]",
                  "double[]",
                  "json"
                ]
              }
            },
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "totalRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalCapped": {
          "type": "boolean"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "sqlHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "rows",
        "columns",
        "totalRows",
        "totalCapped",
        "nextCursor",
        "sqlHash",
        "elapsedMs"
      ],
      "additionalProperties": false
    }
  }
}
