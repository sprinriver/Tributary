{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SourceRef",
  "$defs": {
    "SourceRef": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "releaseIds": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
              }
            }
          },
          "required": [
            "releaseIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "$ref": "#/$defs/DatasetKind"
            },
            "scope": {
              "type": "object",
              "properties": {
                "programIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                  }
                },
                "experimentVersionIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                  }
                },
                "latestPublishedOnly": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "scope"
          ],
          "additionalProperties": false
        }
      ]
    },
    "DatasetKind": {
      "type": "string",
      "enum": [
        "protein_quant",
        "precursor_quant",
        "differential_abundance",
        "dose_response",
        "qc_metrics",
        "rnaseq_counts",
        "crispr_gene_summary",
        "compound",
        "compound_property",
        "target_annotation",
        "id_mapping",
        "experiment_version",
        "sample",
        "file_object",
        "pipeline_run"
      ]
    }
  }
}
