{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/NotificationPreferences",
  "$defs": {
    "NotificationPreferences": {
      "type": "object",
      "properties": {
        "email": {
          "type": "boolean"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "alert.created",
              "triage.assigned",
              "run.finished"
            ]
          }
        },
        "address": {
          "type": "string"
        },
        "email_available": {
          "type": "boolean"
        }
      },
      "required": [
        "email",
        "events",
        "address",
        "email_available"
      ],
      "additionalProperties": false
    }
  }
}
