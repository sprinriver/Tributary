{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/UpdateNotificationRouteBody",
  "$defs": {
    "UpdateNotificationRouteBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "events": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "run.finished",
              "version.published",
              "release.published",
              "triage.decision"
            ]
          }
        },
        "active": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
