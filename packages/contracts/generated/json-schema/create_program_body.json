{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CreateProgramBody",
  "$defs": {
    "CreateProgramBody": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{1,15}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "requires_approval": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "name"
      ],
      "additionalProperties": false
    }
  }
}
