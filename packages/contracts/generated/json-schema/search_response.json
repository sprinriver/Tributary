{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SearchResponse",
  "$defs": {
    "SearchResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SearchHit"
          }
        },
        "facets": {
          "type": "object",
          "properties": {
            "assay_type": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "value",
                  "label",
                  "count"
                ],
                "additionalProperties": false
              }
            },
            "program": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "value",
                  "label",
                  "count"
                ],
                "additionalProperties": false
              }
            },
            "species": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "value",
                  "label",
                  "count"
                ],
                "additionalProperties": false
              }
            },
            "compound": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "value",
                  "label",
                  "count"
                ],
                "additionalProperties": false
              }
            },
            "status": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "value",
                  "label",
                  "count"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "assay_type",
            "program",
            "species",
            "compound",
            "status"
          ],
          "additionalProperties": false
        },
        "total": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "string",
          "enum": [
            "fulltext",
            "hybrid"
          ]
        },
        "capped": {
          "type": "boolean"
        },
        "expansions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term_id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "matched": {
                "type": "string"
              }
            },
            "required": [
              "term_id",
              "label",
              "matched"
            ],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "facets",
        "total",
        "mode",
        "capped",
        "expansions",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "SearchHit": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "experiment",
            "sample"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "experiment_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "experiment_version_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "experiment_name": {
          "type": "string"
        },
        "program_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "program_code": {
          "type": "string"
        },
        "assay_type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "ranks": {
          "type": "object",
          "properties": {
            "fulltext": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "vector": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "fulltext",
            "vector"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "id",
        "experiment_id",
        "experiment_version_id",
        "experiment_name",
        "program_id",
        "program_code",
        "assay_type",
        "status",
        "title",
        "subtitle",
        "snippet",
        "score",
        "ranks"
      ],
      "additionalProperties": false
    }
  }
}
