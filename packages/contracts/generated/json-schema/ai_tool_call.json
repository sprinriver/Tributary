{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AiToolCall",
  "$defs": {
    "AiToolCall": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "error"
          ]
        },
        "input": {},
        "output": {},
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "tool",
        "status",
        "input",
        "output",
        "error"
      ],
      "additionalProperties": false
    }
  }
}
