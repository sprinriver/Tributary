{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ClusterResult",
  "$defs": {
    "ClusterResult": {
      "type": "object",
      "properties": {
        "rows": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClusterTree"
            },
            {
              "type": "null"
            }
          ]
        },
        "columns": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClusterTree"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "method": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "compute_version": {
          "type": "string"
        }
      },
      "required": [
        "rows",
        "columns",
        "seed",
        "method",
        "metric",
        "compute_version"
      ],
      "additionalProperties": false
    },
    "ClusterTree": {
      "type": "object",
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "linkage": {
          "type": "array",
          "items": {
            "minItems": 4,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "support": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "order",
        "linkage",
        "support"
      ],
      "additionalProperties": false
    }
  }
}
