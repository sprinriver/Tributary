    "Fit4plResult": {
      "type": "object",
      "properties": {
        "top": {
          "type": "number"
        },
        "bottom": {
          "type": "number"
        },
        "ec50_molar": {
          "type": "number"
        },
        "pec50": {
          "type": "number"
        },
        "hill_slope": {
          "type": "number"
        },
        "r2": {
          "type": "number"
        },
        "compute_version": {
          "type": "string"
        }
      },
      "required": [
        "top",
        "bottom",
        "ec50_molar",
        "pec50",
        "hill_slope",
        "r2",
        "compute_version"
      ],
      "additionalProperties": false
    }
  }
}
