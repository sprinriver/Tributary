{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/OntologySearchResult",
  "$defs": {
    "OntologySearchResult": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "ols",
            "cache",
            "local"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "synonyms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "label",
              "synonyms"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "source",
        "items"
      ],
      "additionalProperties": false
    }
  }
}
