{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EnrichmentRequest",
  "$defs": {
    "EnrichmentRequest": {
      "type": "object",
      "properties": {
        "hits": {
          "minItems": 1,
          "maxItems": 100000,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "background": {
          "minItems": 1,
          "maxItems": 500000,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "gene_sets": {
          "minItems": 1,
          "maxItems": 100000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "name": {
                "type": "string",
                "maxLength": 500
              },
              "members": {
                "minItems": 1,
                "maxItems": 50000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "required": [
              "id",
              "name",
              "members"
            ],
            "additionalProperties": false
          }
        },
        "min_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "hits",
        "background",
        "gene_sets",
        "min_size",
        "max_size"
      ],
      "additionalProperties": false
    }
  }
}
