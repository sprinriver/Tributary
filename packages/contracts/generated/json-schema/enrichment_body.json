{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EnrichmentBody",
  "$defs": {
    "EnrichmentBody": {
      "type": "object",
      "properties": {
        "release_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "contrast_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "collection_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "direction": {
          "default": "both",
          "type": "string",
          "enum": [
            "up",
            "down",
            "both"
          ]
        },
        "adj_p_max": {
          "default": 0.05,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "abs_log2fc_min": {
          "default": 1,
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "min_size": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_size": {
          "default": 500,
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "release_id",
        "collection_id",
        "direction",
        "adj_p_max",
        "abs_log2fc_min",
        "min_size",
        "max_size"
      ],
      "additionalProperties": false
    }
  }
}
