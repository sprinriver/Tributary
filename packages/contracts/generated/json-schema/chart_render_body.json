{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ChartRenderBody",
  "$defs": {
    "ChartRenderBody": {
      "type": "object",
      "properties": {
        "spec": {
          "$ref": "#/$defs/ChartSpec"
        }
      },
      "required": [
        "spec"
      ],
      "additionalProperties": false
    },
    "ChartSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "line",
            "bar",
            "scatter2d",
            "scatter3d",
            "box_violin",
            "histogram_kde",
            "lollipop",
            "volcano",
            "bubble",
            "heatmap",
            "dendrogram",
            "pie_donut",
            "ma",
            "pca",
            "dose_response",
            "qc_panel"
          ]
        },
        "title": {
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuerySpec"
            },
            {
              "type": "object",
              "properties": {
                "savedViewId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                }
              },
              "required": [
                "savedViewId"
              ],
              "additionalProperties": false
            }
          ]
        },
        "encodings": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "x",
              "y",
              "z",
              "color",
              "shape",
              "opacity",
              "size",
              "hover",
              "panel",
              "label",
              "rowLabel",
              "values",
              "categories"
            ]
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "axes": {
          "type": "object",
          "properties": {
            "x": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "y": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "z": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "layout": {
          "type": "object",
          "properties": {
            "palette": {
              "type": "string",
              "minLength": 1
            },
            "gridX": {
              "type": "boolean"
            },
            "gridY": {
              "type": "boolean"
            },
            "sharedX": {
              "type": "boolean"
            },
            "sharedY": {
              "type": "boolean"
            },
            "sharedLegend": {
              "type": "boolean"
            },
            "subplotLegend": {
              "type": "boolean"
            }
          },
          "required": [
            "palette",
            "gridX",
            "gridY",
            "sharedX",
            "sharedY",
            "sharedLegend",
            "subplotLegend"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "data",
        "encodings",
        "options",
        "layout"
      ],
      "additionalProperties": false
    },
    "QuerySpec": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "joins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Join"
          }
        },
        "where": {
          "$ref": "#/$defs/RuleGroup"
        },
        "select": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9_]*\\.)?[a-z][a-z0-9_]*$"
          }
        },
        "orderBy": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "column": {
                "type": "string",
                "pattern": "^([a-z][a-z0-9_]*\\.)?[a-z][a-z0-9_]*$"
              },
              "dir": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ]
              }
            },
            "required": [
              "column",
              "dir"
            ],
            "additionalProperties": false
          }
        },
        "page": {
          "type": "object",
          "properties": {
            "size": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 25
                },
                {
                  "type": "number",
                  "const": 50
                },
                {
                  "type": "number",
                  "const": 100
                },
                {
                  "type": "number",
                  "const": 500
                },
                {
                  "type": "number",
                  "const": 1000
                }
              ]
            },
            "cursor": {
              "type": "string"
            }
          },
          "required": [
            "size"
          ],
          "additionalProperties": false
        },
        "limitRows": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "SourceRef": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "releaseIds": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
              }
            }
          },
          "required": [
            "releaseIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "$ref": "#/$defs/DatasetKind"
            },
            "scope": {
              "type": "object",
              "properties": {
                "programIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                  }
                },
                "experimentVersionIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                  }
                },
                "latestPublishedOnly": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "scope"
          ],
          "additionalProperties": false
        }
      ]
    },
    "DatasetKind": {
      "type": "string",
      "enum": [
        "protein_quant",
        "precursor_quant",
        "differential_abundance",
        "dose_response",
        "qc_metrics",
        "rnaseq_counts",
        "crispr_gene_summary",
        "compound",
        "compound_property",
        "target_annotation",
        "id_mapping",
        "experiment_version",
        "sample",
        "file_object",
        "pipeline_run"
      ]
    },
    "Join": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "inner",
            "left",
            "right"
          ]
        },
        "target": {
          "$ref": "#/$defs/SourceRef"
        },
        "alias": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "on": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "left": {
                "type": "string",
                "pattern": "^([a-z][a-z0-9_]*\\.)?[a-z][a-z0-9_]*$"
              },
              "op": {
                "type": "string",
                "enum": [
                  "=",
                  "!=",
                  ">",
                  "<",
                  "startsWith"
                ]
              },
              "right": {
                "type": "string",
                "pattern": "^([a-z][a-z0-9_]*\\.)?[a-z][a-z0-9_]*$"
              }
            },
            "required": [
              "left",
              "op",
              "right"
            ],
            "additionalProperties": false
          }
        },
        "where": {
          "$ref": "#/$defs/RuleGroup"
        },
        "explode": {
          "type": "string",
          "enum": [
            "protein_ids",
            "gene_names"
          ]
        },
        "advanced": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "target",
        "alias",
        "on"
      ],
      "additionalProperties": false
    },
    "RuleGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "combinator": {
          "type": "string",
          "enum": [
            "and",
            "or"
          ]
        },
        "not": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rule"
              },
              {
                "$ref": "#/$defs/RuleGroup"
              }
            ]
          }
        }
      },
      "required": [
        "combinator",
        "rules"
      ],
      "additionalProperties": false
    },
    "Rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "field": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*\\.)?[a-z][a-z0-9_]*$"
        },
        "operator": {
          "type": "string",
          "enum": [
            "=",
            "!=",
            "<",
            "<=",
            ">",
            ">=",
            "contains",
            "doesNotContain",
            "beginsWith",
            "endsWith",
            "in",
            "notIn",
            "between",
            "notBetween",
            "null",
            "notNull"
          ]
        },
        "value": {}
      },
      "required": [
        "field",
        "operator"
      ],
      "additionalProperties": false
    }
  }
}
