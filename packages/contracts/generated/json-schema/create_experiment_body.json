{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CreateExperimentBody",
  "$defs": {
    "CreateExperimentBody": {
      "type": "object",
      "properties": {
        "program_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
        },
        "assay_type": {
          "type": "string",
          "enum": [
            "proteomics_dia",
            "proteomics_dda",
            "proteomics_tmt",
            "rnaseq",
            "crispr_screen",
            "ngs_raw"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "program_id",
        "assay_type",
        "name"
      ],
      "additionalProperties": false
    }
  }
}
