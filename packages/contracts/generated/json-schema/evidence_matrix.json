{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EvidenceMatrix",
  "$defs": {
    "EvidenceMatrix": {
      "type": "object",
      "properties": {
        "program_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "programs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "program_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "program_code": {
                "type": "string"
              }
            },
            "required": [
              "program_id",
              "program_code"
            ],
            "additionalProperties": false
          }
        },
        "thresholds": {
          "type": "object",
          "properties": {
            "pec50_min": {
              "type": "number"
            },
            "adj_p_max": {
              "type": "number"
            }
          },
          "required": [
            "pec50_min",
            "adj_p_max"
          ],
          "additionalProperties": false
        },
        "compounds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "compound_id": {
                "type": "string"
              },
              "dose_datasets": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "thermal_datasets": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "compound_id",
              "dose_datasets",
              "thermal_datasets"
            ],
            "additionalProperties": false
          }
        },
        "proteins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "accession": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gene": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "measured_compounds": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "cells": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "dose": {
                      "type": "boolean"
                    },
                    "thermal": {
                      "type": "boolean"
                    },
                    "annotation": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "primary_target",
                            "off_target"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "pec50": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "direction": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "stabilised",
                            "destabilised",
                            "inconsistent",
                            "none"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "dose",
                    "thermal",
                    "annotation",
                    "pec50",
                    "direction"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "key",
              "accession",
              "gene",
              "measured_compounds",
              "cells"
            ],
            "additionalProperties": false
          }
        },
        "truncated": {
          "type": "object",
          "properties": {
            "compounds": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "proteins": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "compounds",
            "proteins"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "program_id",
        "programs",
        "thresholds",
        "compounds",
        "proteins",
        "truncated",
        "notes"
      ],
      "additionalProperties": false
    }
  }
}
