{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/QcOverviewBody",
  "$defs": {
    "QcOverviewBody": {
      "type": "object",
      "properties": {
        "program_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "color_by": {
          "default": "experiment",
          "type": "string",
          "enum": [
            "experiment",
            "plate",
            "condition",
            "experiment_date"
          ]
        },
        "max_experiments": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "color_by",
        "max_experiments"
      ],
      "additionalProperties": false
    }
  }
}
