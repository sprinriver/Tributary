{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AiTurn",
  "$defs": {
    "AiTurn": {
      "$ref": "#/$defs/AiMessage"
    },
    "AiToolCall": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "error",
            "pending_approval",
            "rejected"
          ]
        },
        "input": {},
        "output": {},
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "tool",
        "status",
        "input",
        "output",
        "error"
      ],
      "additionalProperties": false
    },
    "AiProvenance": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "none",
            "stub",
            "anthropic",
            "bedrock"
          ]
        },
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "query_specs": {
          "type": "array",
          "items": {}
        },
        "release_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_tokens": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_version",
        "tools",
        "query_specs",
        "release_ids",
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false
    },
    "AiMessage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant"
          ]
        },
        "text": {
          "type": "string"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AiToolCall"
          }
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/AiProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "refusal": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "category": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "category"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "id",
        "role",
        "text",
        "tool_calls",
        "provenance",
        "refusal",
        "created_at"
      ],
      "additionalProperties": false
    }
  }
}
