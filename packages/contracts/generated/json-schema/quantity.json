{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Quantity",
  "$defs": {
    "Quantity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "canonical": {
          "type": "number",
          "minimum": 0
        },
        "canonicalUnit": {
          "type": "string",
          "enum": [
            "M",
            "h"
          ]
        }
      },
      "required": [
        "value",
        "unit",
        "canonical",
        "canonicalUnit"
      ],
      "additionalProperties": false
    }
  }
}
