{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/HealthStatus",
  "$defs": {
    "HealthStatus": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "down"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "service",
        "status",
        "version"
      ],
      "additionalProperties": false
    }
  }
}
