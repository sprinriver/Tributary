{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CreateWatchBody",
  "$defs": {
    "CreateWatchBody": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "protein",
            "gene",
            "compound"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "label": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "additionalProperties": false
    }
  }
}
