{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/TemplatePreview",
  "$defs": {
    "TemplatePreview": {
      "type": "object",
      "properties": {
        "assay_type": {
          "type": "string",
          "enum": [
            "proteomics_dia",
            "proteomics_dda",
            "proteomics_tmt",
            "rnaseq",
            "crispr_screen",
            "ngs_raw"
          ]
        },
        "version": {
          "type": "string"
        },
        "base_version": {
          "type": "string"
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "newly_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pinned": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "draft": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "published": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "archived": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "draft",
              "published",
              "archived",
              "version"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "assay_type",
        "version",
        "base_version",
        "added",
        "removed",
        "changed",
        "newly_required",
        "pinned"
      ],
      "additionalProperties": false
    }
  }
}
