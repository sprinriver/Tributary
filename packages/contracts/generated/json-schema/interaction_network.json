{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/InteractionNetwork",
  "$defs": {
    "InteractionNetwork": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "log2_fc": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "features": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "direction": {
                "type": "string",
                "enum": [
                  "up",
                  "down",
                  "mixed"
                ]
              },
              "degree": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "log2_fc",
              "features",
              "direction",
              "degree"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "a": {
                "type": "string"
              },
              "b": {
                "type": "string"
              },
              "score": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "a",
              "b",
              "score"
            ],
            "additionalProperties": false
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "release_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "contrast_label": {
              "type": "string"
            },
            "collection": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "name": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "source_release": {
                  "type": "string"
                },
                "id_type": {
                  "type": "string",
                  "enum": [
                    "gene_symbol",
                    "uniprot_accession"
                  ]
                },
                "licence": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "source",
                "source_release",
                "id_type",
                "licence"
              ],
              "additionalProperties": false
            },
            "thresholds": {
              "type": "object",
              "properties": {
                "direction": {
                  "type": "string",
                  "enum": [
                    "up",
                    "down",
                    "both"
                  ]
                },
                "adj_p_max": {
                  "type": "number"
                },
                "abs_log2fc_min": {
                  "type": "number"
                }
              },
              "required": [
                "direction",
                "adj_p_max",
                "abs_log2fc_min"
              ],
              "additionalProperties": false
            },
            "min_score": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "counts": {
              "type": "object",
              "properties": {
                "hits": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "hits_in_collection": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "hits_not_in_collection": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "edges": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "edges_shown": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "hits_connected": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "hits_without_partner": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "hits",
                "hits_in_collection",
                "hits_not_in_collection",
                "edges",
                "edges_shown",
                "hits_connected",
                "hits_without_partner"
              ],
              "additionalProperties": false
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "release_id",
            "contrast_label",
            "collection",
            "thresholds",
            "min_score",
            "counts",
            "notes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodes",
        "edges",
        "provenance"
      ],
      "additionalProperties": false
    }
  }
}
