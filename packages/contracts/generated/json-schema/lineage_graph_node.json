{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LineageGraphNode",
  "$defs": {
    "LineageGraphNode": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "dataset_release",
            "pipeline_run",
            "experiment_version",
            "chart"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "program_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "id",
        "label",
        "detail",
        "status",
        "program_code",
        "depth"
      ],
      "additionalProperties": false
    }
  }
}
