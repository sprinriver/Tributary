{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AiSettings",
  "$defs": {
    "AiSettings": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "type": "string",
          "enum": [
            "none",
            "stub",
            "anthropic",
            "bedrock"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "assistant_enabled": {
          "type": "boolean"
        },
        "write_tools_enabled": {
          "type": "boolean"
        },
        "monthly_token_budget": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tokens_used_this_month": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "risk": {
                "type": "string",
                "enum": [
                  "read",
                  "compute",
                  "write"
                ]
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "risk",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "enabled",
        "provider",
        "model",
        "assistant_enabled",
        "write_tools_enabled",
        "monthly_token_budget",
        "tokens_used_this_month",
        "tools"
      ],
      "additionalProperties": false
    }
  }
}
