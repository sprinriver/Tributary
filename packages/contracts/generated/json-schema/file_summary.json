{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/FileSummary",
  "$defs": {
    "FileSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "experiment_version_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/FileRole"
        },
        "bucket": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "declared_format": {
          "type": [
            "string",
            "null"
          ]
        },
        "ingest_status": {
          "type": "string",
          "enum": [
            "registered",
            "uploading",
            "uploaded",
            "type_detected",
            "contract_validated",
            "qc_passed",
            "qc_failed",
            "published",
            "rejected"
          ]
        },
        "qc_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "qc_report": {
          "anyOf": [
            {
              "$ref": "#/$defs/QcReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "lifecycle_tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "id",
        "experiment_version_id",
        "name",
        "role",
        "bucket",
        "key",
        "size_bytes",
        "sha256",
        "format",
        "declared_format",
        "ingest_status",
        "qc_reason",
        "qc_report",
        "lifecycle_tag",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "FileRole": {
      "type": "string",
      "enum": [
        "raw",
        "processed",
        "metadata",
        "other"
      ]
    },
    "QcReport": {
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/FileFormat"
        },
        "compression": {
          "type": "string",
          "enum": [
            "none",
            "gzip",
            "bgzf"
          ]
        },
        "detected_by": {
          "type": "string",
          "enum": [
            "signature",
            "structure",
            "extension",
            "fallback"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "message": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "passed",
              "message",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "passed": {
          "type": "boolean"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "format",
        "compression",
        "detected_by",
        "sha256",
        "size_bytes",
        "checks",
        "passed",
        "checked_at"
      ],
      "additionalProperties": false
    },
    "FileFormat": {
      "type": "string",
      "enum": [
        "fastq",
        "vcf",
        "bam",
        "csv",
        "tsv",
        "parquet",
        "zip",
        "mzml",
        "thermo_raw",
        "bruker_tdf",
        "bruker_tdf_bin",
        "bruker_baf",
        "sciex_wiff",
        "sciex_wiff_scan",
        "text",
        "binary"
      ]
    }
  }
}
