{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/QcOverview",
  "$defs": {
    "QcOverview": {
      "type": "object",
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "experiment_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "experiment_name": {
                "type": "string"
              },
              "experiment_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "program_code": {
                "type": "string"
              },
              "release_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "sample_key": {
                "type": "string"
              },
              "instrument_run": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ids": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "missing_pct": {
                "type": "number"
              },
              "median_log2_intensity": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "flagged": {
                "type": "boolean"
              },
              "factors": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "experiment_id",
              "experiment_name",
              "experiment_date",
              "program_code",
              "release_id",
              "sample_key",
              "instrument_run",
              "ids",
              "missing_pct",
              "median_log2_intensity",
              "flagged",
              "factors"
            ],
            "additionalProperties": false
          }
        },
        "experiments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "experiment_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "experiment_name": {
                "type": "string"
              },
              "experiment_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "program_code": {
                "type": "string"
              },
              "release_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "dataset_name": {
                "type": "string"
              },
              "importer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "normalisation": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "imputed_cells": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "derived_log2": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "dropped_rows": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "runs": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "median_ids": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "flagged_runs": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "experiment_id",
              "experiment_name",
              "experiment_date",
              "program_code",
              "release_id",
              "dataset_name",
              "importer",
              "normalisation",
              "imputed_cells",
              "derived_log2",
              "dropped_rows",
              "runs",
              "median_ids",
              "flagged_runs"
            ],
            "additionalProperties": false
          }
        },
        "figures": {
          "type": "object",
          "properties": {
            "trend": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "layout": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "data",
                "layout"
              ],
              "additionalProperties": false
            },
            "pca": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      }
                    },
                    "layout": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "data",
                    "layout"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "trend",
            "pca"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "release_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "color_by": {
              "type": "string",
              "enum": [
                "experiment",
                "plate",
                "condition",
                "experiment_date"
              ]
            },
            "pca_features": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "pca_explained": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "pca_note": {
              "type": [
                "string",
                "null"
              ]
            },
            "skipped": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "experiment_name": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "experiment_name",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "transformations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "compute": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "release_ids",
            "color_by",
            "pca_features",
            "pca_explained",
            "pca_note",
            "skipped",
            "transformations",
            "compute"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "runs",
        "experiments",
        "figures",
        "provenance"
      ],
      "additionalProperties": false
    }
  }
}
