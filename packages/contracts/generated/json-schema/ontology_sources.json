{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/OntologySources",
  "$defs": {
    "OntologySources": {
      "type": "object",
      "properties": {
        "ols_url": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "prefix",
              "label",
              "enabled"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ols_url",
        "sources"
      ],
      "additionalProperties": false
    }
  }
}
