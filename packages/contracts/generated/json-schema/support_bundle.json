{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SupportBundle",
  "$defs": {
    "SupportBundle": {
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "instance": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "build": {
              "type": [
                "string",
                "null"
              ]
            },
            "node": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version",
            "build",
            "node",
            "platform"
          ],
          "additionalProperties": false
        },
        "database": {
          "type": "object",
          "properties": {
            "postgres": {
              "type": [
                "string",
                "null"
              ]
            },
            "migrations_applied": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "migrations_pending": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "postgres",
            "migrations_applied",
            "migrations_pending"
          ],
          "additionalProperties": false
        },
        "health": {
          "$ref": "#/$defs/HealthReport"
        },
        "configuration": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "counts": {
          "type": "object",
          "properties": {
            "users": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "programs": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "experiments": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "notification_routes": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "users",
            "programs",
            "experiments",
            "notification_routes"
          ],
          "additionalProperties": false
        },
        "recent_failures": {
          "type": "object",
          "properties": {
            "window_days": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "pipeline_runs": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "latest": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "status": {
                        "type": "string"
                      },
                      "pipeline": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "at": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "status",
                      "pipeline",
                      "at"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "count",
                "latest"
              ],
              "additionalProperties": false
            },
            "notification_deliveries": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "latest": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string"
                      },
                      "event": {
                        "type": "string"
                      },
                      "error": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "attempts": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "at": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "event",
                      "error",
                      "attempts",
                      "at"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "count",
                "latest"
              ],
              "additionalProperties": false
            },
            "emails": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "latest": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "event": {
                        "type": "string"
                      },
                      "error": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "attempts": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "at": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "event",
                      "error",
                      "attempts",
                      "at"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "count",
                "latest"
              ],
              "additionalProperties": false
            },
            "imports_rejected": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "window_days",
            "pipeline_runs",
            "notification_deliveries",
            "emails",
            "imports_rejected"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "generated_at",
        "instance",
        "database",
        "health",
        "configuration",
        "counts",
        "recent_failures"
      ],
      "additionalProperties": false
    },
    "HealthReport": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "down"
          ]
        },
        "checked_at": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "ok",
                  "degraded",
                  "down"
                ]
              },
              "detail": {
                "type": "string"
              },
              "latency_ms": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "label",
              "status",
              "detail",
              "latency_ms"
            ],
            "additionalProperties": false
          }
        },
        "runners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "configured": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "configured",
              "detail"
            ],
            "additionalProperties": false
          }
        },
        "ai": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "provider"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "checked_at",
        "checks",
        "runners",
        "ai"
      ],
      "additionalProperties": false
    }
  }
}
