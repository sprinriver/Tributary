{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ReleaseStorage",
  "$defs": {
    "ReleaseStorage": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "parquet"
        },
        "bucket": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "format",
        "bucket",
        "key",
        "sha256",
        "size_bytes"
      ],
      "additionalProperties": false
    }
  }
}
