{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/VersionResults",
  "$defs": {
    "VersionResults": {
      "type": "object",
      "properties": {
        "experiment_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "experiment_name": {
          "type": "string"
        },
        "version_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "version_number": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "releases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "kind": {
                "$ref": "#/$defs/DatasetKind"
              },
              "dataset_name": {
                "type": "string"
              },
              "importer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tool": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tool_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "row_count": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "kind",
              "dataset_name",
              "importer",
              "tool",
              "tool_version",
              "row_count"
            ],
            "additionalProperties": false
          }
        },
        "contrasts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "label": {
                "type": "string"
              },
              "numerator": {
                "type": "string"
              },
              "denominator": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label",
              "numerator",
              "denominator"
            ],
            "additionalProperties": false
          }
        },
        "run": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "pipeline_name": {
                  "type": "string"
                },
                "pipeline_repo": {
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                },
                "runner": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "finished_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "pipeline_name",
                "pipeline_repo",
                "revision",
                "runner",
                "params",
                "finished_at"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "ingest_status": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "role",
              "ingest_status"
            ],
            "additionalProperties": false
          }
        },
        "thresholds": {
          "type": "object",
          "properties": {
            "fc": {
              "type": "number"
            },
            "p": {
              "type": "number"
            }
          },
          "required": [
            "fc",
            "p"
          ],
          "additionalProperties": false
        },
        "methods": {
          "type": "string"
        }
      },
      "required": [
        "experiment_id",
        "experiment_name",
        "version_id",
        "version_number",
        "releases",
        "contrasts",
        "run",
        "files",
        "thresholds",
        "methods"
      ],
      "additionalProperties": false
    },
    "DatasetKind": {
      "type": "string",
      "enum": [
        "protein_quant",
        "precursor_quant",
        "differential_abundance",
        "dose_response",
        "qc_metrics",
        "rnaseq_counts",
        "crispr_gene_summary",
        "compound",
        "compound_property",
        "target_annotation",
        "id_mapping",
        "experiment_version",
        "sample",
        "file_object",
        "pipeline_run"
      ]
    }
  }
}
