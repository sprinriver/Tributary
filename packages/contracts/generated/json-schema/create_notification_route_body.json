{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CreateNotificationRouteBody",
  "$defs": {
    "CreateNotificationRouteBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": [
            "slack",
            "teams"
          ]
        },
        "url": {
          "type": "string",
          "maxLength": 2000,
          "format": "uri"
        },
        "program_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "events": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "run.finished",
              "version.published",
              "release.published",
              "triage.decision"
            ]
          }
        }
      },
      "required": [
        "name",
        "kind",
        "url",
        "events"
      ],
      "additionalProperties": false
    }
  }
}
