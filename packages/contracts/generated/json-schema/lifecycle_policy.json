{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LifecyclePolicy",
  "$defs": {
    "LifecyclePolicy": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "raw",
            "processed",
            "metadata",
            "other",
            "work",
            "export"
          ]
        },
        "tag": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "transition_days": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 36500
            },
            {
              "type": "null"
            }
          ]
        },
        "storage_class": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "STANDARD_IA",
                "INTELLIGENT_TIERING",
                "GLACIER_IR",
                "GLACIER",
                "DEEP_ARCHIVE"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "expiration_days": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 36500
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "role",
        "tag",
        "transition_days",
        "storage_class",
        "expiration_days"
      ],
      "additionalProperties": false
    }
  }
}
