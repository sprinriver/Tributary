{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PutPicklistBody",
  "$defs": {
    "PutPicklistBody": {
      "type": "object",
      "properties": {
        "values": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": false
    }
  }
}
