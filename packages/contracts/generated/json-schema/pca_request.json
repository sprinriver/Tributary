{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PcaRequest",
  "$defs": {
    "PcaRequest": {
      "type": "object",
      "properties": {
        "values": {
          "minItems": 1,
          "type": "array",
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "scale": {
          "type": "boolean"
        },
        "components": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "values",
        "scale",
        "components"
      ],
      "additionalProperties": false
    }
  }
}
