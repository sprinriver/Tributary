{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/UploadedParts",
  "$defs": {
    "UploadedParts": {
      "type": "object",
      "properties": {
        "upload_id": {
          "type": "string"
        },
        "part_size": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "part_count": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "part_number": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "etag": {
                "type": "string"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "part_number",
              "etag",
              "size_bytes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "upload_id",
        "part_size",
        "part_count",
        "parts"
      ],
      "additionalProperties": false
    }
  }
}
