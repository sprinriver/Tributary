# Keep build contexts small and free of local state and secrets.
**/node_modules
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.turbo
**/dist
.git
.github
.claude
.runs
artifacts
e2e
test-results
playwright-report
coverage
# Terraform stays out, except the Content-Security-Policy the web build also reads (apps/web/vite.config.ts).
infra/terraform/**
!infra/terraform/modules/cloudfront/csp.json
**/.env
**/.env.*
!**/.env.example
