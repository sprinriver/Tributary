{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": { "baseRef": "head" },
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm check *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test *)",
      "Bash(pnpm e2e)",
      "Bash(pnpm e2e *)",
      "Bash(pnpm gen)",
      "Bash(pnpm synth)",
      "Bash(pnpm synth *)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm bench:query)",
      "Bash(pnpm bench:query *)",
      "Bash(pnpm eval:ai)",
      "Bash(pnpm dev)",
      "Bash(docker compose up *)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git tag -l *)",
      "Bash(git rev-parse *)",
      "Bash(test -f *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate)",
      "Bash(terraform validate *)",
      "Bash(tflint *)"
    ],
    "ask": [
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm i)",
      "Bash(pnpm i *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm compute:sync)",
      "Bash(pnpm run compute:sync)",
      "Bash(pnpm run compute:sync *)",
      "Bash(uv add *)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(docker compose down *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(terraform plan *)",
      "Bash(aws *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Bash(terraform apply)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy)",
      "Bash(terraform destroy *)",
      "Bash(tofu apply *)",
      "Bash(tofu destroy *)",
      "Bash(aws * delete-*)",
      "Bash(aws s3 rm *)",
      "Bash(aws s3 rb *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-verify.sh", "timeout": 900 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "tail -n 40 \"$CLAUDE_PROJECT_DIR\"/docs/PROGRESS.md; git -C \"$CLAUDE_PROJECT_DIR\" log --oneline -5" }
        ]
      }
    ]
  }
}
